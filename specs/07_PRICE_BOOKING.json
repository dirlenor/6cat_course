        "location_information": "three-columns-or-controlled-stack"
      },

      "mobile": {
        "offer_overview": {
          "layout": "single-column",
          "order": [
            "offer-intro",
            "quick-info"
          ]
        },

        "quick_info": {
          "layout": "two-column-grid"
        },

        "pricing": {
          "layout": "single-column",
          "order": [
            "package-solo",
            "package-buddy"
          ]
        },

        "pricing_card": {
          "layout": "vertical",
          "media": "top",
          "content": "bottom",
          "cta": "full-width"
        },

        "location_information": {
          "layout": "single-column",
          "use_horizontal_dividers": true
        },

        "closing_note": {
          "alignment": "center"
        }
