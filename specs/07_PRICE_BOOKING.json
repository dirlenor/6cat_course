{
  "section": {
    "id": "section-06",
    "name": "Price & Booking",
    "type": "pricing-booking",
    "reference": "final-approved-section-06",

    "purpose": "Present the full-day private workshop offer, clearly compare SOLO and BUDDY pricing, communicate the workshop format and flexible-location policy, and provide the final booking actions.",

    "design_system": {
      "source": "DESIGN_SYSTEM.md",
      "inherit_global_tokens": true,
      "container": "container.default",
      "theme": "dark",
      "background": "#0A0A0A",
      "accent": "#FA5001"
    },

    "implementation_priority": [
      "dark-section-composition",
      "intro-and-quick-info-layout",
      "pricing-hierarchy",
      "two-package-comparison",
      "large-price-readability",
      "booking-cta-visibility",
      "location-information",
      "vertical-flow",
      "whitespace"
    ],

    "visual_phase": {
      "current_phase": "direct-design",
      "use_real_images": true,
      "use_real_icons": true,
      "use_final_graphics": true,
      "use_animation": false,
      "placeholder_required_for_missing_visual_assets": true,
      "viewport_qa": "desktop-first"
    },

    "overall_layout": {
      "direction": "vertical",
      "alignment": "center",
      "composition": "minimal-dark-pricing-section",
      "content_density": "medium",
      "section_behavior": "content-driven-height",
      "full_viewport_height": false,

      "story_flow": [
        "section-label",
        "intro-and-quick-info",
        "pricing-grid",
        "location-information",
        "closing-note"
      ],

      "notes": [
        "This is the final section of the page.",
        "Do not force all content into one viewport.",
        "Keep the layout minimal and spacious.",
        "The pricing area is the primary conversion point."
      ]
    },

    "section_header": {
      "id": "section-06-label",
      "component": "SectionLabel",
      "position": "top-center",
      "alignment": "center",

      "content": {
        "number": "06",
        "label": "PRICE & BOOKING"
      },

      "variant": "dark-background",

      "notes": "The reference image shows 07, but implementation must use 06 because this is the sixth and final section."
    },

    "offer_overview": {
      "id": "offer-overview",
      "position": "below-section-label",
      "layout": "two-column",
      "relative_width": "full-container",
      "vertical_alignment": "center",

      "left": {
        "id": "offer-intro",
        "grid_span": 5,
        "alignment": "left",

        "headline": {
          "content": [
            {
              "text": "เรียน 1 วัน",
              "style_role": "inverse-primary"
            },
            {
              "text": "ทำเว็บเป็นของตัวเอง",
              "style_role": "mixed",
              "highlight_text": "ทำเว็บ"
            }
          ],

          "typography": {
            "token": "type.h2"
          },

          "line_break": "intentional-two-line"
        },

        "journey": {
          "type": "inline-process",
          "items": [
            "ออกแบบ",
            "สร้าง",
            "ขึ้นออนไลน์"
          ],

          "connector": "arrow-right",
          "connector_style": "accent"
        },

        "decorative_elements": [
          {
            "type": "hand-drawn-underline",
            "target": "ทำเว็บ"
          },
          {
            "type": "doodle-emphasis",
            "position": "left"
          },
          {
            "type": "doodle-star",
            "position": "right"
          }
        ]
      },

      "right": {
        "id": "quick-info",
        "grid_span": 7,
        "layout": "four-column-grid",

        "items": [
          {
            "id": "info-duration",
            "icon": {
              "type": "icon-placeholder",
              "future_icon": "clock"
            },
            "title": "6 HOURS",
            "description": [
              "แบ่งเป็น 2 Part",
              "(3 ชม. + 3 ชม.)"
            ]
          },
          {
            "id": "info-people",
            "icon": {
              "type": "icon-placeholder",
              "future_icon": "users"
            },
            "title": "1–2 PEOPLE",
            "description": [
              "Private",
              "Workshop"
            ]
          },
          {
            "id": "info-snack",
            "icon": {
              "type": "icon-placeholder",
              "future_icon": "coffee"
            },
            "title": "FREE DRINK & SNACK",
            "description": [
              "น้ำ + ขนม",
              "ระหว่างเรียน"
            ]
          },
          {
            "id": "info-location",
            "icon": {
              "type": "icon-placeholder",
              "future_icon": "map-pin"
            },
            "title": "FLEXIBLE LOCATION",
            "description": [
              "เรียนได้มากกว่า",
              "ที่คิด"
            ]
          }
        ],

        "item_style": {
          "component": "InfoCard",
          "layout": "vertical",
          "alignment": "center",
          "equal_height": true,
          "background": "dark-elevated",
          "border": "subtle-dark-border",
          "icon_role": "accent"
        },

        "notes": "These are compact information cards, not primary feature cards. Keep them smaller than the pricing cards."
      }
    },

    "pricing_grid": {
      "id": "pricing-grid",
      "position": "below-offer-overview",
      "layout": "two-column",
      "columns": 2,
      "relative_width": "full-container",

      "packages": [
        {
          "id": "package-solo",
          "name": "SOLO",
          "people": "1 คน",
          "price": "3,999.-",
          "variant": "standard",

          "layout": {
            "type": "horizontal-card",
            "media": "left",
            "content": "right",
            "grid_ratio": "approximately-40-60"
          },

          "media": {
            "type": "image-placeholder",
            "label": "IMAGE",
            "aspect_ratio": "portrait",
            "purpose": "Future workshop, student, project or course-related visual."
          },

          "content": {
            "features": [
              "เรียนแบบ Private 1:1",
              "Workshop เต็มวัน 6 ชั่วโมง",
              "ออกแบบ + สร้าง + ขึ้นออนไลน์",
              "ปรึกษาและตอบทุกปัญหา",
              "น้ำ + ขนม ระหว่างเรียน"
            ],

            "cta": {
              "component": "Button.Primary",
              "text": "จอง SOLO",
              "trailing_icon": "arrow-right"
            }
          }
        },

        {
          "id": "package-buddy",
          "name": "BUDDY",
          "people": "2 คน",
          "price": "5,999.-",
          "price_note": "เฉลี่ยเพียง 2,999.50 บาท/คน",
          "variant": "featured",

          "layout": {
            "type": "horizontal-card",
            "media": "left",
            "content": "right",
            "grid_ratio": "approximately-40-60"
          },

          "media": {
            "type": "image-placeholder",
            "label": "IMAGE",
            "aspect_ratio": "portrait",
            "purpose": "Future workshop, two-student, project or course-related visual."
          },

          "content": {
            "features": [
              "ทุกอย่างเหมือน SOLO",
              "มา 2 คน ใน Session เดียวกัน",
              "ช่วยกันคิด ช่วยกันทำ ได้ผลงานไวขึ้น",
              "ปรึกษาและตอบทุกปัญหา",
              "น้ำ + ขนม ระหว่างเรียน"
            ],

            "cta": {
              "component": "Button.Primary",
              "text": "จอง BUDDY",
              "trailing_icon": "arrow-right"
            }
          }
        }
      ],

      "shared_card_structure": {
        "component": "PricingCard",
        "equal_height": true,
        "content_alignment": "stretch",

        "content_order": [
          "media",
          "package-name",
          "people",
          "price",
          "price-note-if-present",
          "features",
          "cta"
        ],

        "feature_icon": {
          "type": "check",
          "style_role": "accent"
        }
      },

      "variants": {
        "standard": {
          "background": "dark",
          "border": "neutral-visible",
          "price": "accent-primary"
        },

        "featured": {
          "background": "dark",
          "border": "accent-primary",
          "package_name": "accent-primary",
          "price": "accent-primary"
        }
      },

      "notes": [
        "SOLO and BUDDY must have equal visual weight and equal card height.",
        "BUDDY receives an orange border to indicate the featured option.",
        "Do not make BUDDY physically much larger than SOLO.",
        "Prices must be among the strongest typography elements in the entire section.",
        "Keep CTA aligned toward the bottom of both cards."
      ]
    },

    "location_information": {
      "id": "location-information",
      "position": "below-pricing-grid",
      "layout": "three-column-horizontal-panel",
      "relative_width": "full-container",

      "items": [
