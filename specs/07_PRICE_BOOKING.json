      "session_capacity": "1-2 people",
      "location_policy": "flexible",
      "standard_service_area": "exact boundaries still require final definition"
    },

    "codex_constraints": [
      "This is Section 06, not Section 07.",
      "This is the final section of the landing page.",
      "DESIGN_SYSTEM.md is the global styling source of truth.",
      "Use the global 1280px container.",
      "Use Noto Sans Thai from the global typography system.",
      "Normal body copy uses font-weight 300.",
      "Use #FA5001 through the global accent token.",
      "Use a near-black background for the entire section.",
