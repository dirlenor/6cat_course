        }
      ],

      "item_structure": {
        "layout": "icon-left-content-right",
        "icon_role": "accent",
        "title": "strong",
        "description": "body-small-light"
      },

      "notes": [
        "The three location items belong to one unified horizontal panel.",
        "Do not create three large independent cards.",
        "Use subtle vertical separators between items."
      ]
    },

    "closing_note": {
      "id": "booking-closing-note",
      "position": "below-location-information",
      "alignment": "center",

      "icon": {
        "type": "icon-placeholder",
        "future_icon": "shield-check"
      },

      "text": "1 วัน 1 Session เท่านั้น เพื่อคุณภาพและเวลาเต็มที่ในการเรียนรู้",

      "typography": {
        "token": "type.body"
      },

      "importance": "secondary"
    },

    "vertical_flow": [
      "section-label",
      "offer-overview",
      "pricing-grid",
      "location-information",
      "closing-note"
    ],

    "relative_spacing": {
